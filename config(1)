#!/bin/sh
lb config noauto \
  --distribution trixie \
  --architectures amd64 \
  --binary-images iso-hybrid \
  --bootloaders "grub-efi,syslinux" \
  --debian-installer none \
  --archive-areas "main contrib non-free non-free-firmware" \
  --iso-application "Lumora" --iso-volume "LUMORA" \
  --bootappend-live "boot=live components quiet splash username=lumora hostname=lumora" \
  "${@}"
